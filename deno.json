{
  "exclude": [
    "dist/",
    ".astro/",
    "node_modules/"
  ],
  "tasks": {
    "fmt": "deno fmt",
    "dev": "astro dev",
    "lint": "deno lint",
    "build": "astro build",
    "check": "deno check src/**/*.ts src/**/*.tsx"
  },
  "imports": {
    "@astrojs/react": "npm:@astrojs/react@6.0.1",
    "@deno/astro-adapter": "npm:@deno/astro-adapter@0.6.0",
    "@types/react": "npm:@types/react@19.2.17",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "astro": "npm:astro@7.0.9",
    "browserslist": "npm:browserslist@4.28.6",
    "lightningcss": "npm:lightningcss@1.32.0",
    "pdfkit": "npm:pdfkit@^0.19.1",
    "react": "npm:react@19.2.7",
    "react-dom": "npm:react-dom@19.2.7",
    "satteri": "npm:satteri@^0.9.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.ns",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "webworker",
      "webworker.iterable",
      "webworker.asynciterable",
      "webworker.importscripts"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "trailingCommas": "never"
  },
  "lint": {
    "rules": {
      "tags": [
        "jsr",
        "jsx",
        "react",
        "recommended",
        "workspace"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-await-in-loop",
        "no-const-assign",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-undef",
        "no-useless-rename",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal"
      ],
      "exclude": [
        "no-sloppy-imports"
      ]
    }
  },
  "nodeModulesDir": "auto",
  "unstable": [
    "bundle",
    "cron",
    "fmt-sql",
    "fmt-component",
    "kv",
    "sloppy-imports",
    "tsgo",
    "webgpu",
    "worker-options"
  ]
}
